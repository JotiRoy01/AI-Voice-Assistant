# ==============================================================================
# FlowMind AI — AI Voice Order Confirmation System (SRS v1.0)
# Copy this file to .env and replace secrets before deploying to production.
# ==============================================================================

# --- Core Runtime ---
NODE_ENV=development
PORT=4000
DATA_STORE=mysql                     # 'mysql' for production/Docker, 'memory' for zero-dep local dev/tests
QUEUE_MODE=bullmq                    # 'bullmq' (Redis) for production/Docker, 'inline' for zero-dep local dev
ORCHESTRATION_MODE=direct            # 'n8n' to trigger n8n workflow, 'direct' for direct worker adapter execution
SIMULATOR_ENABLED=true               # Set to 'false' in production!

# --- Security & Encryption (REQUIRED in production) ---
JWT_SECRET=flowmind-dev-jwt-secret-change-in-production-min-32-chars
INTERNAL_SERVICE_TOKEN=flowmind-internal-service-token-change-me
# 64 hex characters (32 bytes) for AES-256-GCM encryption of provider credentials
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Webhook Signing Secrets ---
DEFAULT_SHOPIFY_WEBHOOK_SECRET=shopify-demo-webhook-secret
DEFAULT_WOOCOMMERCE_WEBHOOK_SECRET=woo-demo-webhook-secret
DEFAULT_CUSTOM_WEBHOOK_SECRET=custom-demo-webhook-secret
TELEPHONY_WEBHOOK_SECRET=telephony-callback-hmac-secret
WHATSAPP_APP_SECRET=whatsapp-app-hmac-secret
WHATSAPP_VERIFY_TOKEN=flowmind-whatsapp-verify-token

# --- MySQL ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=flowmind_voice
MYSQL_USER=flowmind
MYSQL_PASSWORD=flowmind_secret_password
MYSQL_ROOT_PASSWORD=flowmind_root_password

# --- Redis / BullMQ ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CALL_WORKER_CONCURRENCY=5
CALL_RATE_LIMIT_MAX=20
CALL_RATE_LIMIT_DURATION_MS=60000

# --- n8n Orchestration ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/flowmind-call-trigger
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=flowmind_n8n_password
N8N_ENCRYPTION_KEY=flowmind-n8n-encryption-key-change-me

# --- Bangla TTS Microservice ---
TTS_SERVICE_URL=http://tts:8000
TTS_PROVIDER=local_http              # 'local_http' | 'mock'
TTS_DEFAULT_VOICE=bn-BD-NabanitaNeural

# --- Telephony Adapter ---
TELEPHONY_PROVIDER=simulator         # 'simulator' | 'asterisk_ari'
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USER=flowmind
ASTERISK_ARI_PASSWORD=flowmind_ari_secret
ASTERISK_SIP_TRUNK=bd-sip-trunk
ASTERISK_CALLER_ID=+8809600000000
PUBLIC_CALLBACK_BASE_URL=http://backend:4000

# --- WhatsApp Adapter ---
WHATSAPP_PROVIDER=simulator          # 'simulator' | 'meta_cloud'
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_NUMBER=+8801700000000
WHATSAPP_API_VERSION=v21.0

# --- Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
